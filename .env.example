# Copy to .env.local and fill in from your Supabase project settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key (Project Settings → API → Publishable key).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy anon JWT also works on older projects:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev / intentional device testing: shorten bake step timers (AlarmKit, etc.).
# Vite also loads these on `vite build`, so `npm run build:ios` refuses them unless
# you opt in: ALLOW_BAKE_TIMER_TEST=1 npm run build:ios
# VITE_BAKE_TIMER_TEST_MINUTES=1
# Optional: limit the override to one timeline step id (e.g. coil-fold-1).
# VITE_BAKE_TIMER_TEST_STEP_ID=coil-fold-1
